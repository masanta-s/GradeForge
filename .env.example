# GradeForge secrets. Copy this file to `.env` (same folder) and fill in what you use.
# `.env` is git-ignored: the example is shared, the tokens are not. Nothing here is required
# for local grading, which needs no accounts at all.

# Kaggle: run the fine-tuning notebook on Kaggle's free GPUs.
# kaggle.com -> avatar -> Settings -> API -> Create New Token. Paste the token here (or the path
# to the file Kaggle downloaded). Notebooks also need Phone Verification on your Kaggle account.
KAGGLE_API_TOKEN=

# HuggingFace: only for gated models or if downloads get rate-limited.
# huggingface.co -> Settings -> Access Tokens (read access is enough).
HF_TOKEN=

# Cloud grading (all optional, and off unless you switch to a cloud model and consent).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
